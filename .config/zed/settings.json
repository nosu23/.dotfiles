{
  "terminal": {
    "font_size": 14.0
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "JetBrains Dark"
  },
  // 👇 ここからインデントの挙動をコントロールする設定を追加しています
  "auto_indent": false, // 改行したときに勝手にインデントが入るのを防ぐ
  "auto_indent_on_paste": false, // コピペしたときに階段状にズレるのを防ぐ
  "format_on_save": "off", // 保存した瞬間に勝手にインデントが変わるのを防ぐ

  // 👇 SQLとYAMLのタブ幅（スペース数）を明示的に固定したい場合のオプション
  "languages": {
    "SQL": {
      "tab_size": 4
    },
    "YAML": {
      "tab_size": 2
    }
  }