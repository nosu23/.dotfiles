{
  "terminal": {
    "font_size": 14.0
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "JetBrains Dark"
  },
  "auto_indent": false,
  "auto_indent_on_paste": false,
  "format_on_save": "off",
  "languages": {
    "SQL": {
      "tab_size": 4
    },
    "YAML": {
      "tab_size": 2
    }
  }
}
